# Environment variables untuk SilverCare MCP Server
# JANGAN commit file ini ke git — sudah di-ignore via .gitignore

# Langflow connection
LANGFLOW_BASE_URL=http://127.0.0.1:7860
LANGFLOW_API_KEY=your-langflow-api-key

# Astra DB
ASTRA_DB_APPLICATION_TOKEN=AstraCS:xxxxxx
ASTRA_DB_API_ENDPOINT=https://xxxx-xxxx.apps.astra.datastax.com

# Flow IDs — isi setelah flow dibuat di Langflow
# Cara dapat Flow ID: buka flow di Langflow → lihat URL → /flow/{FLOW_ID}
FLOW_MEDICATION_SCHEDULE=
FLOW_DRUG_INTERACTION=
FLOW_HEALTH_SYMPTOM=
FLOW_CAREGIVER_LEAVE=
